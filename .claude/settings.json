{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)"
    ]
  }
}
